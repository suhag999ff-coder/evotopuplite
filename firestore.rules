rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────── HELPERS ───────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function notChanging(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ─────────── ADMINS (role source-of-truth) ───────────
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // ⚠️ Only via Firebase Console
    }

    // ─────────── USERS ───────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.balance == 0
        && request.resource.data.totalSpend == 0;
      allow update: if isAdmin()
        || (isOwner(userId)
            && notChanging(['balance','totalSpend','totalOrders','weeklySpend'])
            || notChanging(['role','suspended','supportPin']));
      allow delete: if isAdmin();
    }

    // ─────────── PUBLIC CONTENT ───────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
      match /products/{productId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────── ORDERS ───────────
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ─────────── DEPOSITS ───────────
    match /deposits/{depositId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ─────────── REDEEM CODES ───────────
    match /codes/{codeId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.usedBy == request.auth.uid)
        || (isSignedIn() && resource.data.used == false); // allow lookup for redeem
      allow create, update, delete: if isAdmin();
    }

    // ─────────── CHAT ───────────
    match /chats/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      match /messages/{msgId} {
        allow read, create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // ─────────── SETTINGS ───────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────── ADMIN-ONLY ───────────
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // ─────────── ACTIVITY LOGS ───────────
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ─────────── DEFAULT DENY ───────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}